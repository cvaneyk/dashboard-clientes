APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Marca de la PLATAFORMA (config/marca.php): la de la página de login y la de
# quien no pertenece a ninguna agencia. Cada agencia pone la suya en
# /admin → Mi agencia. Sin logo se muestra MARCA_NOMBRE en texto. Los logos
# pueden ser URL absoluta o ruta dentro de public/ (p. ej. /img/logo.png).
MARCA_NOMBRE="Portal de clientes"
MARCA_LOGO_URL=
# Versión clara para el pie oscuro; vacío = la misma que MARCA_LOGO_URL.
MARCA_LOGO_PIE_URL=
MARCA_WEB=
MARCA_ESLOGAN=
# Email del superadmin que crea el primer despliegue (solo si no existe ningún admin).
ADMIN_EMAIL=admin@example.com

# Solo para datos sin agencia (instalaciones anteriores a las agencias). Cada
# agencia pone el suyo en /admin → Mi agencia.
INFORME_ADMIN_EMAIL=

# APPS DE API: desde que hay agencias, cada agencia pone las suyas en
# /admin → Mi agencia (se guardan cifradas). Las de aquí abajo solo se usan
# para crear la primera agencia al migrar una instalación que ya tenía datos.

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Meta Marketing API (solo para el método OAuth; el token de System User se
# pega por cuenta en /admin). Crea la app en developers.facebook.com y copia
# aquí App ID y App Secret. En "Valid OAuth Redirect URIs" de la app añade:
#   https://TU-DOMINIO/conexiones/meta/callback
META_APP_ID=
META_APP_SECRET=
# META_API_VERSION=v23.0

# Google Ads API. Las tres primeras son de agencia (valen para todos los
# clientes); lo propio de cada cliente es el customer ID de su Cuenta.
# El developer token se pide desde la MCC y lo aprueba Google.
# client_id/secret: proyecto de Google Cloud con la Google Ads API habilitada y
# {APP_URL}/conexiones/google/callback en los URIs de redirección autorizados.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
# MCC de la agencia (solo dígitos). Cada Cuenta puede sobrescribirla.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# GOOGLE_ADS_API_VERSION=v25

# LinkedIn Ads. App en developer.linkedin.com asociada a una página de empresa,
# con {APP_URL}/conexiones/linkedin/callback en "Authorized redirect URLs".
# REQUIERE la aprobación del Marketing Developer Platform: sin ella LinkedIn no
# concede r_ads / r_ads_reporting y la conexión no puede leer nada.
LINKEDIN_ADS_CLIENT_ID=
LINKEDIN_ADS_CLIENT_SECRET=
# Cabecera LinkedIn-Version (AAAAMM). LinkedIn retira versiones periódicamente.
# LINKEDIN_ADS_API_VERSION=202608
# Permisos a pedir. Deben coincidir con los concedidos a la app (Auth → "OAuth
# 2.0 scopes"); si no, LinkedIn responde "The requested permission scope is not
# valid" antes de dejarte autorizar.
# LINKEDIN_ADS_SCOPES="r_ads r_ads_reporting"

# Spotify Ads. App en developer.spotify.com marcando "Ads API", con
# {APP_URL}/conexiones/spotify/callback en "Redirect URIs". Hay que aceptar los
# términos de la Ads API con el client ID en adsmanager.spotify.com/api-terms
# (tarda hasta una hora); sin eso todas las llamadas fallan.
SPOTIFY_ADS_CLIENT_ID=
SPOTIFY_ADS_CLIENT_SECRET=
# Qué cuenta como lead, por prioridad (campos del informe de Spotify).
# SPOTIFY_ADS_TIPOS_CONVERSION=LEADS,SIGN_UPS

# OpenAI Ads no lleva nada aquí: la clave de API es por cuenta publicitaria y
# se pega en la ficha de la Cuenta en /admin.
